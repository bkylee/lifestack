# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit actual secrets.

# ---- Database ----
# Local dev: Docker Postgres (docker-compose.yml)
# Production: loaded from Azure Key Vault via managed identity at startup
DATABASE_URL="postgresql://lifestack:lifestack_dev@localhost:5432/lifestack"

# ---- Auth.js (NextAuth) — added in Step 5 ----
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
