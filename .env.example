# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit actual secrets.

# ---- Database ----
# Local dev: Docker Postgres (docker-compose.yml)
# Production: loaded from Azure Key Vault via managed identity at startup
DATABASE_URL="postgresql://lifestack:lifestack_dev@localhost:5432/lifestack"

# ---- Auth.js (NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
# Redirect URI: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
