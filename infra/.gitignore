# Terraform working directory and cached providers (regenerated by `terraform init`)
.terraform/

# State files — should never live on disk; remote backend is the source of truth
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan output files
*.tfplan

# Crash logs
crash.log
crash.*.log

# Local override files (used for ad-hoc debugging, never committed)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Note: .terraform.lock.hcl IS committed — it pins exact provider versions
#       across the team and across CI runs.
